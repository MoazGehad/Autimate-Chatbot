# ==============================================================================
# BrainLight RAG Chatbot Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Backend Configuration
# ------------------------------------------------------------------------------
# Choose which LLM backend to use: 'local' (Qwen) or 'gemini'
LLM_BACKEND=gemini

# If using 'gemini', provide your Google API key
GEMINI_API_KEY=AIzaSyD7VuSGXAgYyJBA3DKelSh68Bdlh-Hwh7w

# Which Gemini model to use (default: gemini-2.0-flash-lite for speed/cost)
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# ------------------------------------------------------------------------------
# Advanced Retrieval Features (Feature Flags)
# ------------------------------------------------------------------------------
# Step 2a: Enable LLM-based query rewriting to generate 2-3 sub-queries
QUERY_REWRITE_ENABLED=true

# Step 2b: Enable hybrid retrieval (Dense ChromaDB + Sparse BM25)
# NOTE: You must run the /ingest endpoint once to generate the BM25 index file!
BM25_ENABLED=false

# Step 2c: Enable cross-encoder reranking of the top results after RRF fusion
RERANKER_ENABLED=false

# Step 2d: Enable contextual compression (sentence-level cosine similarity filtering)
COMPRESSION_ENABLED=false

# ------------------------------------------------------------------------------
# Advanced Retrieval Tuning Parameters
# ------------------------------------------------------------------------------
# Minimum cosine similarity threshold for a sentence to be kept during compression
COMPRESSION_THRESHOLD=0.4

# Cross-encoder model to use for reranking
# Default is 'cross-encoder/mmarco-mMiniLMv2-L12-H384-v1' which is good for Arabic
RERANKER_MODEL_ID=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Number of top chunks to pass to the generator after reranking
RERANKER_TOP_N=4

# Reciprocal Rank Fusion (RRF) constant (usually between 50 and 60)
RRF_K=60

# Path to save/load the BM25 pickle index
BM25_INDEX_PATH=data/bm25_index.pkl
